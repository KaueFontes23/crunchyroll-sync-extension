# Copie para .env.local e preencha com os dados do app Web do seu projeto Firebase.
# Estes campos não são chaves privadas; ainda assim, mantenha a configuração local.
VITE_FIREBASE_API_KEY=COLE_A_API_KEY_DO_APP_WEB
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://seu-projeto-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_APP_ID=COLE_O_APP_ID_DO_APP_WEB
